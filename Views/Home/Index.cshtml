@model FuelInfoApp.ViewModels.MapViewModel
@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout_Map";
}

<div id="map" style="height: 90vh; width: 100%;"></div>
@section Scripts {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/map.js"></script>
    
    <script>
        var map = L.map('map', {
            zoomControl: false
        }).setView([-27.45004, 151.95113], 13);
        L.tileLayer('http://{s}.tile.osm.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="http://osm.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        L.control.zoom({
            position: 'bottomright'
        }).addTo(map);
        map.on('zoomend', function() {
            
        });
        map.on('dragend', function() {
            const center = map.getBounds().getCenter();
            const zoom = map.getZoom();
            $.ajax({
                complete: UpdateMapPosition,
                url: "/Home/UpdateMap?lat=" + center.lat + "%lon" + center.lng,
                dataType: "json"
            });
        });
        
        function UpdateMapPosition(data) {
            console.log("got ajax reply back");
        }
    </script>
}
